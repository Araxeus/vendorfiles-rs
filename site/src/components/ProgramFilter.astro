---
// A search box that narrows the program table that follows it.
---

<label class="program-filter">
  <span>Filter programs</span>
  <input type="search" placeholder="disk, git, editor…" autocomplete="off" />
</label>

<script>
  for (const box of document.querySelectorAll<HTMLInputElement>('.program-filter input')) {
    const table = box.closest('label')?.parentElement?.querySelector('table');

    box.addEventListener('input', () => {
      const words = box.value.toLowerCase().split(/\s+/).filter(Boolean);
      for (const row of table?.querySelectorAll<HTMLElement>('tbody tr') ?? []) {
        const text = row.textContent?.toLowerCase() ?? '';
        row.hidden = !words.every((word) => text.includes(word));
      }
    });
  }
</script>

<style>
  /* The box stays under the header while the table scrolls beneath it. */

  .program-filter {
    position: sticky;
    top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.75rem;
    background: var(--sl-color-bg);
  }

  /* A row's short cells sit level with the middle of a wrapped description. */

  .program-filter ~ :global(table td) {
    vertical-align: middle;
  }

  .program-filter span {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .program-filter input {
    max-width: 24rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
</style>
